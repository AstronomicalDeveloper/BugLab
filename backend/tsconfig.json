{
  // Visit https://aka.ms/tsconfig to read more about this file
  // Solo se compila src/. `vitest.config.ts` vive en la raiz de backend/ y lo
  // lee vitest por su cuenta, no hace falta pasarlo por tsc.
  "include": ["src"],
  "compilerOptions": {
    // File Layout
    // Sin outDir, `tsc` emite el .js/.d.ts al lado de cada fuente y ensucia
    // src/. Ademas `npm start` arranca `dist/server.js`, que asi nunca existia.
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
